# =============================================================================
# NestJS Backend - Environment Configuration
# =============================================================================
# LLM provider + embeddings mirror the ITAL-IA project: all BAML functions use
# the AzureFoundry client (Azure OpenAI gpt-4.1 deployment) and embeddings use
# Azure text-embedding-3-large (3072 dims).

# -----------------------------------------------------------------------------
# DATABASE - Prisma + PostgreSQL (Supabase pooled/session or local)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/app_db?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/app_db?schema=public"

# -----------------------------------------------------------------------------
# AZURE OPENAI — chat/extraction (BAML `AzureFoundry` client)
# base_url already points at the gpt-4.1 deployment.
# -----------------------------------------------------------------------------
AZURE_OPENAI_BASE_URL=https://westeurope.api.cognitive.microsoft.com/openai/deployments/gpt-4.1
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_API_KEY=your-azure-openai-api-key

# -----------------------------------------------------------------------------
# AZURE OPENAI — embeddings (text-embedding-3-large, 3072 dims)
# -----------------------------------------------------------------------------
AZURE_OPENAI_EMBEDDINGS_ENDPOINT=https://westeurope.api.cognitive.microsoft.com/
AZURE_OPENAI_EMBEDDINGS_MODEL=text-embedding-3-large
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_EMBEDDINGS_API_VERSION=2024-02-01
AZURE_OPENAI_EMBEDDINGS_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_EMBEDDINGS_DIM=3072

# -----------------------------------------------------------------------------
# VECTOR DATABASE - local Qdrant (the `qdrant` service in docker-compose).
# Host-side (seed/upload scripts) use localhost:6333; inside the Docker network
# the api uses http://qdrant:6333 (overridden in docker-compose.yml).
# Local Qdrant has no auth, so QDRANT_API_KEY stays empty.
# -----------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Low garbage floor, NOT a relevance gate (mirrors ITAL-IA). text-embedding-3-*
# cosine scores for relevant matches land ~0.5-0.6, so an absolute cutoff is not
# separable — relevance is decided by top-K rank (QDRANT_SEARCH_LIMIT).
QDRANT_COLLECTION_NAME=tripper-kb
QDRANT_SCORE_THRESHOLD=0.30
QDRANT_SEARCH_LIMIT=5

# -----------------------------------------------------------------------------
# ALTERNATIVE LLM PROVIDERS (optional — only needed if you switch a BAML
# function back to GPT52 / GPT5Mini / Claude / Gemini / Ollama clients)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_API_KEY=your-google-api-key
OLLAMA_BASE_URL=http://localhost:11434/v1

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------
PORT=8000
NODE_ENV=development
